FROM ubuntu:24.04 AS builder
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends build-essential cmake pkg-config qt6-base-dev libqt6opengl6-dev libglib2.0-dev libxcb1-dev dpkg-dev file xvfb xauth python3 ca-certificates libgl1-mesa-dri && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY . .
RUN sh scripts/render-native-build.sh
FROM ubuntu:24.04
RUN apt-get update && apt-get install -y --no-install-recommends python3 ca-certificates && rm -rf /var/lib/apt/lists/* && useradd --system --uid 10001 --no-create-home linwin
COPY --from=builder /out/ /public/
COPY scripts/download_server.py /opt/linwin/download_server.py
USER 10001
WORKDIR /public
EXPOSE 10000
CMD ["python3","/opt/linwin/download_server.py"]
