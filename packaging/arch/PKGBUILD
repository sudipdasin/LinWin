# Maintainer: LinWin contributors
pkgname=linwin
pkgver=0.5.0
pkgrel=1
pkgdesc='Lightweight Windows-style Linux desktop shell preview'
arch=('x86_64')
url='https://github.com/sudipdasin/LinWin'
license=('GPL-3.0-or-later')
depends=('glib2' 'qt6-base')
makedepends=('cmake' 'gcc' 'pkgconf')
source=("linwin-${pkgver}.tar.gz")
sha256sums=('SKIP')

build() {
    cmake -S "${srcdir}" -B "${srcdir}/build" \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DBUILD_TESTING=OFF
    cmake --build "${srcdir}/build" --parallel 2
}

package() {
    DESTDIR="${pkgdir}" cmake --install "${srcdir}/build"
}
